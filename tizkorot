// "dd/mm/yyyy" -> {day, month, year} (Gregorian), או null אם הפורמט לא תקין
function parseDdMmYyyy(str) {
  if (!str) return null;
  const parts = String(str).trim().split("/");
  if (parts.length !== 3) return null;
  const day = parseInt(parts[0], 10);
  const month = parseInt(parts[1], 10);
  const year = parseInt(parts[2], 10);
  if (!day || !month || !year) return null;
  return { day, month, year };
}

// בודק אם התאריך הלועזי הנתון הוא ראש חודש (יום 1, או יום 30 - קיים רק בחודשים בני 30 יום -
// שהוא היום הראשון מתוך יומיים של ר"ח), לא כולל ראש השנה (א' תשרי) שאינו נחשב "ראש חודש" בהקשר הזה.
// נשען על תמיכת Intl בלוח עברי ב-Apps Script V8 runtime.
//
// חשוב: הבדיקה היא "האם היום עצמו יום ל'", לא "האם מחר יום א'" - כי בחודש בן 29 יום, יום 29
// ("היום") ואחריו ישר יום א' של החודש הבא ("מחר") - וזה לא אומר שהיום כבר ראש חודש.
function getRoshChodeshInfo(date) {
  const todayHeb = getHebrewDateParts(date);

  if (todayHeb.day === 1 && todayHeb.monthName !== "תשרי") {
    return { isRoshChodesh: true, monthName: todayHeb.monthName };
  }

  if (todayHeb.day === 30) {
    const tomorrow = new Date(date);
    tomorrow.setDate(tomorrow.getDate() + 1);
    const tomorrowHeb = getHebrewDateParts(tomorrow);
    if (tomorrowHeb.monthName !== "תשרי") {
      return { isRoshChodesh: true, monthName: tomorrowHeb.monthName };
    }
  }

  return { isRoshChodesh: false, monthName: null };
}

// פורט מדויק מ-toGematria בתוכנת קאפיטל עצמה (C:\scripts\CAPITEL\test\src\lib\formatters.ts) -
// אותה לוגיקה בדיוק, כולל הטיפול המיוחד ב-15/16 (ט"ו/ט"ז, נמנעים מצירופי אותיות שם ה').
const GEMATRIA_ONES = ['', 'א', 'ב', 'ג', 'ד', 'ה', 'ו', 'ז', 'ח', 'ט'];
const GEMATRIA_TENS = ['', 'י', 'כ', 'ל', 'מ', 'נ', 'ס', 'ע', 'פ', 'צ'];
const GEMATRIA_HUNDREDS = ['', 'ק', 'ר', 'ש', 'ת'];

function toGematria(num) {
  if (num <= 0) return String(num);
  if (num === 15) return 'ט"ו';
  if (num === 16) return 'ט"ז';
  let n = num;
  let result = '';
  let hundreds = Math.floor(n / 100);
  n %= 100;
  const tens = Math.floor(n / 10);
  const ones = n % 10;
  while (hundreds > 4) {
    result += 'ת';
    hundreds -= 4;
  }
  result += GEMATRIA_HUNDREDS[hundreds] || '';
  result += GEMATRIA_TENS[tens] || '';
  result += GEMATRIA_ONES[ones] || '';
  if (result.length === 0) return String(num);
  if (result.length === 1) return result + "'";
  return result.slice(0, -1) + '"' + result.slice(-1);
}

// מזהה אם שם חודש (כפי שמגיע מ-Intl) הוא גרסה כלשהי של אדר, בלי תלות בסימן הגרש המדויק
// שמשתמשים בו ("א׳"/"א'"), כי משווים רק את האות העברית שנשארת אחרי הסרת סימני פיסוק.
function getAdarVariant(monthName) {
  if (!monthName || monthName.indexOf("אדר") !== 0) return null;
  const rest = monthName.slice(3).replace(/[^א-ת]/g, "");
  if (rest === "") return "plain";
  if (rest === "א") return "I";
  if (rest === "ב") return "II";
  return null;
}

// מיישם בדיוק את כלל אדר של תוכנת קאפיטל עצמה (normalizeMonthName ב-src/lib/hebrewDate.ts):
// "אדר" סתם שנרשם בשנה פשוטה, מול שנת יעד מעוברת, מתאים לאדר ב' (לא א'). אדר א'/אדר ב' שנרשמו
// בשנה מעוברת, מול שנת יעד פשוטה, שניהם מתכנסים ל"אדר" הפשוט. אחרת - השוואה ישירה.
function monthsMatchForAnniversary(birthMonthName, targetMonthName) {
  if (birthMonthName === targetMonthName) return true;
  const birthVariant = getAdarVariant(birthMonthName);
  const targetVariant = getAdarVariant(targetMonthName);
  if (!birthVariant || !targetVariant) return false;
  if (targetVariant === "plain") return true; // שנת היעד פשוטה - יש בה רק אדר אחד, לא משנה מאיזו גרסה נולד
  if (birthVariant === "plain") return targetVariant === "II"; // כלל קאפיטל: "אדר" סתם => אדר ב' בשנה מעוברת
  return birthVariant === targetVariant;
}

function getHebrewDateParts(date) {
  const fmt = new Intl.DateTimeFormat("he-u-ca-hebrew", { day: "numeric", month: "long", year: "numeric" });
  const parts = fmt.formatToParts(date);
  const day = parseInt(parts.find(p => p.type === "day").value, 10);
  const monthName = parts.find(p => p.type === "month").value;
  const yearPart = parts.find(p => p.type === "year");
  const yearName = yearPart ? yearPart.value : "";
  return { day, monthName, yearName };
}

