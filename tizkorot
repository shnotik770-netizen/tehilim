// יש להריץ פעם אחת ידנית כדי להתקין את שני הטריגרים היומיים (08:00 ו-11:00 שעון ישראל) -
// הריצה השנייה (11:00) היא ניסיון חזרה למי שלא קיבל בפועל בריצת ה-8:00 (למשל בגלל שגיאת שרת),
// בזכות ההגנה ב-dailyReminderCheck שרק מוסיפה ל-Reminders_Log אחרי הצלחה מאומתת. שם הפונקציה
// השתנה מ-installDailyReminderTrigger (יחיד) - יש להריץ מחדש כדי להחליף טריגר בודד ישן.
function installDailyReminderTriggers() {
  ScriptApp.getProjectTriggers().forEach(t => {
    if (t.getHandlerFunction() === "dailyReminderCheck") ScriptApp.deleteTrigger(t);
  });
  [8, 11].forEach(hour => {
    ScriptApp.newTrigger("dailyReminderCheck")
      .timeBased()
      .atHour(hour)
      .everyDays(1)
      .inTimezone("Asia/Jerusalem")
      .create();
  });
}

// כמה ימים קדימה בודקים לצורך "משלוח מוקדם" סביב שבת/חג.
// 4 נותן שוליים גם למקרה נדיר של חג משולש (יו"ט צמוד לשבת), לא רק 2 הימים שביקשת —
// אם הרצף החסום קצר יותר, הלולאה עוצרת ביום הראשון שאינו חסום ולא שולחת מעבר לכך.
const REMINDER_LOOKAHEAD_CAP = 4;

// רצה פעמיים ביום (8:00 ו-11:00, ראו installDailyReminderTriggers) - הריצה השנייה היא בדיוק
// "ניסיון חזרה" למי שלא קיבל בפועל בריצה הראשונה. לכן אין כאן חסם "פעם ביום" גלובלי; ההגנה
// היחידה מפני שליחה כפולה היא reminderSignature מול Reminders_Log, שנרשם רק אחרי הצלחה מאומתת.
function dailyReminderCheck() {
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(20000)) return; // ריצה אחרת כבר בעיצומה (למשל שני הפעלות ידניות כמעט יחד) - לא רצים במקביל
  try {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const userSheet = ss.getSheetByName("users");
    if (!userSheet) return;

    const settings = getSystemSettings();
    const now = new Date();

    const userData = userSheet.getDataRange().getValues();
    const blockedInfo = getBlockedSendDates(now, REMINDER_LOOKAHEAD_CAP);
    const outcome = computeDueReminders(userData, settings, now, blockedInfo);
    if (outcome.skippedBlocked) return; // היום עצמו שבת/חג - כבר נשלח מראש בריצה קודמת

    const alreadySent = loadAlreadySentReminderKeys(ss);
    outcome.results.forEach(r => {
      const key = reminderSignature(r);
      if (alreadySent.has(key)) return; // אותו טלפון+סוג+פרטים+שנה עברית כבר נשלח בהצלחה בעבר

      const res = sendSingleSms(r.phone, r.message, API_KEY);
      if (res && res.responseStatus === "OK") {
        logOutgoing(ss, r.phone, r.message);
        logReminderSent(ss, r.phone, r.type, r.detail, r.isAdvance, r.hebrewYear);
        alreadySent.add(key);
      } else {
        // לא נכנס ל-Reminders_Log ולא ל-alreadySent - כך שריצת ה-11:00 תנסה שוב באופן טבעי.
        // תגובת השרת המלאה (או "אין תגובה" אם הייתה שגיאת רשת) נשמרת ל-Send_Failures לבדיקה.
        logSendFailure(ss, r.phone, r.type + " - " + r.detail, res);
      }
    });
  } finally {
    lock.releaseLock();
  }
}

function reminderSignature(r) {
  return r.phone + "_" + r.type + "_" + r.detail + "_" + r.hebrewYear;
}

// טוען מ-Reminders_Log את כל האירועים שכבר נשלחו בפועל, לשימוש כהגנה נגד שליחה כפולה
// (טלפון+סוג+פרטים+שנה עברית) - זו ההגנה שאמורה לעבוד גם אם dailyReminderCheck מופעל
// ידנית יותר מפעם אחת על אותו מצב, ולא רק ההגנה החד-פעמית של last_daily_reminder_run.
function loadAlreadySentReminderKeys(ss) {
  const sheet = ss.getSheetByName("Reminders_Log");
  const set = new Set();
  if (!sheet) return set;
  const data = sheet.getDataRange().getValues();
  for (let i = 1; i < data.length; i++) {
    set.add(normalizePhone(data[i][1]) + "_" + data[i][2] + "_" + data[i][3] + "_" + String(data[i][5]));
  }
  return set;
}

// הלוגיקה ה"טהורה" שמחליטה מה צריך להישלח - בלי לשלוח או לרשום בפועל. משמשת הן את
// dailyReminderCheck (הריצה האמיתית) והן את מסך הבדיקות בדשבורד (simulateReminderRange),
// כדי ששני הנתיבים תמיד יתנהגו זהה.
function computeDueReminders(userData, settings, targetNow, blockedInfo) {
  const todayStr = Utilities.formatDate(targetNow, "Asia/Jerusalem", "yyyy-MM-dd");

  if (blockedInfo.dates.has(todayStr)) {
    return { skippedBlocked: true, results: [] };
  }

  let results = collectRemindersForDate(userData, settings, targetNow, false);

  for (let i = 1; i <= REMINDER_LOOKAHEAD_CAP; i++) {
    const future = new Date(targetNow);
    future.setDate(future.getDate() + i);
    const futureStr = Utilities.formatDate(future, "Asia/Jerusalem", "yyyy-MM-dd");
    if (!blockedInfo.dates.has(futureStr)) break; // הרצף החסום נגמר - השאר יטופלו ביומם

    // כשראש חודש נמשך יומיים (למשל ל' בשישי + א' בשבת), שני הימים שייכים לאותו "אירוע" ר"ח -
    // אם כבר יש בתוצאות הודעת ר"ח לאותו טלפון/חודש (מהיום הטבעי או מיום קדימה קודם), לא כופלים אותה.
    collectRemindersForDate(userData, settings, future, true).forEach(r => {
      const isDuplicateRoshChodesh = r.type === "ראש חודש" &&
        results.some(existing => existing.type === "ראש חודש" && existing.phone === r.phone && existing.detail === r.detail);
      if (!isDuplicateRoshChodesh) results.push(r);
    });
  }

  return { skippedBlocked: false, results: results };
}

// מרכיב את רשימת התזכורות (ראש חודש/יום הולדת) שמגיעות ל-targetDate, ללא כל תופעת לוואי
// (לא שולח, לא כותב ליומן). isAdvance=true כשמדובר במשלוח מוקדם כי targetDate עצמו חסום.
function collectRemindersForDate(userData, settings, targetDate, isAdvance) {
  const results = [];
  const rc = getRoshChodeshInfo(targetDate);
  const targetHeb = getHebrewDateParts(targetDate);
  const targetDateStr = Utilities.formatDate(targetDate, "Asia/Jerusalem", "yyyy-MM-dd");

  for (let i = 1; i < userData.length; i++) {
    const phone = normalizePhone(userData[i][0]);
    if (!phone) continue;

    const rcReminder = !!userData[i][1];
    if (rcReminder && rc.isRoshChodesh) {
      let msg = fillTemplate(settings.msg_rosh_chodesh, { month: rc.monthName });
      if (isAdvance) msg = prefixAdvanceNote(msg, targetDate);
      results.push({ phone, type: "ראש חודש", detail: rc.monthName, message: msg, targetDate: targetDateStr, isAdvance, hebrewYear: targetHeb.yearName });
    }

    let chapters = [];
    try { chapters = JSON.parse(userData[i][2]) || []; } catch (e) { chapters = []; }

    chapters.forEach(ch => {
      const bd = parseDdMmYyyy(ch.birth_date);
      if (!bd) return;
      // birth_date נשמר כתאריך לועזי, אבל מייצג יום עברי קבוע (כך האתר ממיר בזמן ההרשמה -
      // ראו ReminderModal.tsx / hebrewToGregorian) - ממירים אותו בחזרה ללוח עברי ומשווים
      // יום+חודש עברי מול היום העברי הנוכחי, כי יום/חודש לועזי לא חוזר על עצמו כל שנה
      // באותו יום עברי (הלוחות נעים זה ביחס לזה). חודש מושווה דרך monthsMatchForAnniversary
      // כדי לטפל נכון באדר בשנה מעוברת/פשוטה, לפי אותו כלל בדיוק שקיים בתוכנת קאפיטל עצמה.
      const birthDate = new Date(bd.year, bd.month - 1, bd.day, 12, 0, 0);
      const birthHeb = getHebrewDateParts(birthDate);
      if (birthHeb.day === targetHeb.day && monthsMatchForAnniversary(birthHeb.monthName, targetHeb.monthName)) {
        const age = parseInt(targetHeb.yearName, 10) - parseInt(birthHeb.yearName, 10);
        // {date} ו-{chapter} מוצגים בגימטריה (כמו בתוכנת קאפיטל - toGematria, בלי תחילית "ב" לפני
        // החודש), אבל נוסח ההודעה עצמו (msg_birthday) לא מוחלף - רק הערכים שמוזנים לתוכו.
        let msg = fillTemplate(settings.msg_birthday, {
          name: ch.name,
          date: toGematria(targetHeb.day) + " " + targetHeb.monthName,
          chapter: toGematria(age + 1)
        });
        if (isAdvance) msg = prefixAdvanceNote(msg, targetDate);
        results.push({ phone, type: "יום הולדת", detail: ch.name + " - פרק " + (age + 1), message: msg, targetDate: targetDateStr, isAdvance, hebrewYear: targetHeb.yearName });
      }
    });
  }

  return results;
}

function prefixAdvanceNote(msg, targetDate) {
  const dateStr = Utilities.formatDate(targetDate, "Asia/Jerusalem", "dd/MM");
  return "תזכורת מוקדמת ל-" + dateStr + " (בשל שבת/חג שבו לא ניתן לשלוח הודעות):\n" + msg;
}

// מחזיר { dates: Set<"yyyy-MM-dd">, reasons: {"yyyy-MM-dd": string} } לטווח [fromDate, fromDate+numDays]
// עבור ימים שהם שבת או יום טוב בישראל. שבת מחושבת ישירות; ימי טוב נשלפים מ-Hebcal
// (API ציבורי, לא דורש מפתח). reasons משמש רק לתצוגה במסך הבדיקות.
function getBlockedSendDates(fromDate, numDays) {
  const dates = new Set();
  const reasons = {};

  for (let i = 0; i <= numDays; i++) {
    const d = new Date(fromDate);
    d.setDate(d.getDate() + i);
    if (d.getDay() === 6) {
      const key = Utilities.formatDate(d, "Asia/Jerusalem", "yyyy-MM-dd");
      dates.add(key);
      reasons[key] = "שבת";
    }
  }

  try {
    const endDate = new Date(fromDate);
    endDate.setDate(endDate.getDate() + numDays);
    const url = "https://www.hebcal.com/hebcal?cfg=json&v=1&start=" +
      Utilities.formatDate(fromDate, "Asia/Jerusalem", "yyyy-MM-dd") + "&end=" +
      Utilities.formatDate(endDate, "Asia/Jerusalem", "yyyy-MM-dd") +
      "&i=on&maj=on&min=off&mod=off&nx=off&ss=off&mf=off&c=off";
    const response = UrlFetchApp.fetch(url, { muteHttpExceptions: true });
    if (response.getResponseCode() === 200) {
      const json = JSON.parse(response.getContentText());
      (json.items || []).forEach(item => {
        if (item.yomtov) {
          const key = String(item.date).substring(0, 10);
          dates.add(key);
          reasons[key] = item.title || "חג";
        }
      });
    }
  } catch (e) {
    // אם הקריאה ל-Hebcal נכשלה, ממשיכים עם שבתות בלבד - עדיף תת-זיהוי של חג בודד
    // מאשר לעצור את כל ריצת התזכורות היומית.
  }

  return { dates: dates, reasons: reasons };
}

