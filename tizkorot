function normalizePhone(phoneStr) {
  if (!phoneStr) return "";
  let safeStr = String(phoneStr);
  let digits = safeStr.replace(/\D/g, '');
  if (digits.startsWith("0")) digits = "972" + digits.substring(1);
  else if (digits.length === 9 && !digits.startsWith("972")) digits = "972" + digits;
  return digits;
}

