function cronCheckIncomingSms() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const settings = getSystemSettings(); // טעינת הטקסטים המותאמים אישית

  let userSheet = ss.getSheetByName("users") || ss.insertSheet("users");
  if (userSheet.getLastRow() === 0) userSheet.appendRow(["טלפון נמען", "תזכורת ראש חודש", "פרקים וימי הולדת", "תאריך רישום", "הודעה מקורית"]);

  let configSheet = ss.getSheetByName("system_config") || ss.insertSheet("system_config");
  if (configSheet.getLastRow() === 0) {
    configSheet.appendRow(["key", "value"]);
    configSheet.appendRow(["last_processed_time", "2025-01-01 00:00:00"]);
  }

  let logSheet = ss.getSheetByName("Messages_Log") || ss.insertSheet("Messages_Log");
  if (logSheet.getLastRow() === 0) logSheet.appendRow(["Date", "Phone", "Direction", "Message"]);

  const lastProcessedStr = getConfigValue(configSheet, "last_processed_time") || "2025-01-01 00:00:00";
  const lastProcessedDate = new Date(lastProcessedStr);
  let latestProcessedTime = lastProcessedDate.getTime();

  const now = new Date();
  const spamWindowStart = now.getTime() - SPAM_THRESHOLD_MINUTES * 60 * 1000;

  const logData = logSheet.getDataRange().getValues();
  const existingSignatures = new Set();
  const recentInCounts = {}; // מספר הודעות IN לכל טלפון בתוך חלון הזמן האחרון, לזיהוי שיבוש
  const startIdx = Math.max(1, logData.length - 500);
  for (let i = startIdx; i < logData.length; i++) {
    let d = logData[i][0];
    let dStr = (d instanceof Date) ? Utilities.formatDate(d, "Asia/Jerusalem", "yyyy-MM-dd HH:mm:ss") : String(d);
    const rowPhone = normalizePhone(logData[i][1]);
    existingSignatures.add(dStr + "_" + rowPhone + "_" + logData[i][2]);

    if (logData[i][2] === "IN") {
      const rowTime = (d instanceof Date) ? d.getTime() : new Date(d).getTime();
      if (rowTime >= spamWindowStart) {
        recentInCounts[rowPhone] = (recentInCounts[rowPhone] || 0) + 1;
      }
    }
  }

  const blockedSet = loadBlockedSet(ss);

  const incoming = getIncomingSms(API_KEY, lastProcessedDate);
  incoming.forEach(msg => {
    const phone = normalizePhone(msg.source);
    const text = msg.message || "";
    const msgTime = new Date(msg.receive_date).getTime();

    const sig = msg.receive_date + "_" + phone + "_IN";
    if (existingSignatures.has(sig)) return;

    if (msgTime > latestProcessedTime) latestProcessedTime = msgTime;
    logSheet.appendRow([msg.receive_date, phone, "IN", text]);

    if (blockedSet.has(phone)) return; // מספר חסום - מתעדים בלוג בלבד, בלי כל עיבוד או תגובה

    recentInCounts[phone] = (recentInCounts[phone] || 0) + 1;
    if (recentInCounts[phone] >= SPAM_THRESHOLD_COUNT) {
      blockNumber(ss, phone, recentInCounts[phone] + " הודעות תוך " + SPAM_THRESHOLD_MINUTES + " דקות");
      blockedSet.add(phone);
      return; // חסימה - גם ההודעה שחצתה את הסף לא מקבלת תגובה
    }

    // "הסר"/"הסרה" נתפסות כתת-מחרוזת אחת של השנייה, אבל "להסיר" (ל-ה-ס-י-ר) לא מכילה את הרצף
    // "הסר" בגלל ה-י' שנכנסת באמצע - לכן בודקים את שלוש הצורות בנפרד ולא סתם includes("הסר").
    const removalKeywords = ["הסר", "הסרה", "להסיר"];
    if (removalKeywords.some(kw => text.includes(kw))) {
      if (removeUserByPhone(userSheet, phone)) {
        const res = sendSingleSms(phone, settings.msg_remove, API_KEY);
        if (!(res && res.responseStatus === "OK")) logSendFailure(ss, phone, "הודעת הסרה", res);
      }
      return;
    }

    // זיהוי הפורמט העברי החדש
    if (text.includes("[רישום לקאפיטל]")) {
      const parsedData = parseSmsRegistrationHebrew(text);
      const isUpdate = saveOrUpdateUser(userSheet, phone, parsedData, text);

      if (isUpdate) {
        const res = sendSingleSms(phone, settings.msg_update, API_KEY);
        if (!(res && res.responseStatus === "OK")) logSendFailure(ss, phone, "הודעת עדכון רישום", res);
      } else {
        const res = sendSingleSms(phone, settings.msg_welcome, API_KEY);
        if (!(res && res.responseStatus === "OK")) logSendFailure(ss, phone, "הודעת קבלה לרישום", res);
      }
    }
  });

  const outgoing = getSmsOutLog(API_KEY, lastProcessedDate);
  outgoing.forEach(msg => {
    const phone = normalizePhone(msg.To);
    const text = msg.Message || "";
    const msgTime = new Date(msg.Time).getTime();

    const sig = msg.Time + "_" + phone + "_OUT";
    if (existingSignatures.has(sig)) return;

    if (msgTime > latestProcessedTime) latestProcessedTime = msgTime;
    logSheet.appendRow([msg.Time, phone, "OUT", text]);
  });

  if (latestProcessedTime > lastProcessedDate.getTime()) {
    const nextPointer = new Date(latestProcessedTime);
    setConfigValue(configSheet, "last_processed_time", Utilities.formatDate(nextPointer, "Asia/Jerusalem", "yyyy-MM-dd HH:mm:ss"));
  }
}

// מפרק את הפורמט העברי החדש
function parseSmsRegistrationHebrew(text) {
  let rcReminder = text.includes("ראש חודש: כן") || text.includes("ראש חודש: V") || text.includes("ראש חודש: true");
  let chapters = [];
  const lines = text.split("\n");
  let isParsingChapters = false;

  lines.forEach(line => {
    const cleanLine = line.trim();
    if (cleanLine.includes("שמות ותאריכים:")) {
      isParsingChapters = true;
      return;
    }

    // אם אנחנו בשלב הפרקים ויש פסיק שמפריד בין שם לתאריך
    if (isParsingChapters && cleanLine.includes(",")) {
      const parts = cleanLine.split(",");
      if (parts.length >= 2) {
        chapters.push({
          name: parts[0].trim(),
          birth_date: parts[1].trim()
        });
      }
    }
  });

  return { rcReminder: rcReminder, chapters: chapters };
}

function removeUserByPhone(sheet, phone) {
  const data = sheet.getDataRange().getValues();
  const normPhone = normalizePhone(phone);
  for (let i = 1; i < data.length; i++) {
    if (normalizePhone(data[i][0]) === normPhone) {
      sheet.deleteRow(i + 1);
      return true;
    }
  }
  return false;
}

function saveOrUpdateUser(sheet, phone, data, originalText) {
  const dataRange = sheet.getDataRange();
  const values = dataRange.getValues();
  const normPhone = normalizePhone(phone);
  let userRowIndex = -1;

  for (let i = 1; i < values.length; i++) {
    if (normalizePhone(values[i][0]) === normPhone) {
      userRowIndex = i + 1;
      break;
    }
  }

  const jsonChapters = JSON.stringify(data.chapters);
  const now = new Date();

  if (userRowIndex !== -1) {
    sheet.getRange(userRowIndex, 2).setValue(data.rcReminder);
    sheet.getRange(userRowIndex, 3).setValue(jsonChapters);
    sheet.getRange(userRowIndex, 4).setValue(now);
    sheet.getRange(userRowIndex, 5).setValue(originalText);
    return true;
  } else {
    sheet.appendRow([phone, data.rcReminder, jsonChapters, now, originalText]);
    return false;
  }
}

function getIncomingSms(apiKey, startDate) {
  try {
    const payload = { token: apiKey, limit: 1000 };
    if (startDate) payload.startDate = Utilities.formatDate(startDate, "Asia/Jerusalem", "yyyy-MM-dd HH:mm:ss");

    const options = { method: 'post', contentType: 'application/json', payload: JSON.stringify(payload), muteHttpExceptions: true };
    const response = UrlFetchApp.fetch("https://www.call2all.co.il/ym/api/GetIncomingSms", options);
    const res = JSON.parse(response.getContentText());
    return res.responseStatus === "OK" ? (res.rows || []) : [];
  } catch (e) { return []; }
}

function getSmsOutLog(apiKey, startDate) {
  try {
    const payload = { token: apiKey, limit: 1000 };
    if (startDate) payload.startDate = Utilities.formatDate(startDate, "Asia/Jerusalem", "yyyy-MM-dd HH:mm:ss");

    const options = { method: 'post', contentType: 'application/json', payload: JSON.stringify(payload), muteHttpExceptions: true };
    const response = UrlFetchApp.fetch("https://www.call2all.co.il/ym/api/GetSmsOutLog", options);
    if (response.getResponseCode() !== 200) return [];

    const res = JSON.parse(response.getContentText());
    return res.responseStatus === "OK" ? (res.rows || []) : [];
  } catch (e) { return []; }
}

function sendSingleSms(phone, message, apiKey) {
  try {
    const options = { method: 'post', contentType: 'application/json', payload: JSON.stringify({ token: apiKey, phones: phone, message: message }), muteHttpExceptions: true };
    const response = UrlFetchApp.fetch("https://www.call2all.co.il/ym/api/SendSms", options);
    return JSON.parse(response.getContentText());
  } catch (e) { return null; }
}

function getConfigValue(sheet, key) {
  const values = sheet.getDataRange().getValues();
  for (let i = 1; i < values.length; i++) {
    if (values[i][0] === key) return values[i][1];
  }
  return null;
}

function setConfigValue(sheet, key, value) {
  const values = sheet.getDataRange().getValues();
  for (let i = 1; i < values.length; i++) {
    if (values[i][0] === key) {
      sheet.getRange(i + 1, 2).setValue(value);
      return;
    }
  }
  sheet.appendRow([key, value]);
}

