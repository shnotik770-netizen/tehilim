// מדמה הרצה יומית עבור טווח תאריכים, בלי לשלוח SMS ובלי לכתוב ליומנים - כדי לוודא
// שהמרת התאריך העברי, זיהוי ראש חודש/שבת/חג, וההיגיון של "משלוח מוקדם" עובדים נכון,
// לפני שמפעילים את הטריגר האמיתי מול משתמשים אמיתיים.
function simulateReminderRange(startDateStr, numDays) {
  try {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const userSheet = ss.getSheetByName("users");
    const userData = userSheet ? userSheet.getDataRange().getValues() : [[]];
    const settings = getSystemSettings();

    const cappedDays = Math.max(1, Math.min(numDays || 14, 60)); // הגנה מפני ריצה ארוכה מדי
    const startDate = parseSimDate(startDateStr);
    // Set משותף אחד לכל הטווח (כולל שולי ה-lookahead), כדי שלא יהיו קריאות רשת חוזרות ל-Hebcal לכל יום
    const blockedInfo = getBlockedSendDates(startDate, cappedDays + REMINDER_LOOKAHEAD_CAP);

    const days = [];
    for (let d = 0; d < cappedDays; d++) {
      const simDate = new Date(startDate);
      simDate.setDate(simDate.getDate() + d);
      const dateStr = Utilities.formatDate(simDate, "Asia/Jerusalem", "yyyy-MM-dd");
      const heb = getHebrewDateParts(simDate);
      const rc = getRoshChodeshInfo(simDate);
      const outcome = computeDueReminders(userData, settings, simDate, blockedInfo);

      days.push({
        date: dateStr,
        weekday: Utilities.formatDate(simDate, "Asia/Jerusalem", "EEEE"),
        hebrewDate: heb.day + " ב" + heb.monthName + " " + heb.yearName,
        isBlocked: blockedInfo.dates.has(dateStr),
        blockReason: blockedInfo.reasons[dateStr] || null,
        isRoshChodesh: rc.isRoshChodesh,
        roshChodeshMonth: rc.monthName,
        skippedToday: outcome.skippedBlocked,
        reminders: outcome.results
      });
    }

    return { status: "success", days: days };
  } catch (e) {
    return { status: "error", message: e.toString() };
  }
}

// "yyyy-MM-dd" -> Date בשעה 12:00 (נמנע מהחלקה ליום שכן בגלל הפרשי אזור זמן)
function parseSimDate(dateStr) {
  if (!dateStr) return new Date();
  const parts = String(dateStr).split("-");
  if (parts.length !== 3) return new Date();
  return new Date(Number(parts[0]), Number(parts[1]) - 1, Number(parts[2]), 12, 0, 0);
}

// מחליף {placeholders} בתבנית הודעה בערכים בפועל
function fillTemplate(template, values) {
  let out = template || "";
  for (const key in values) {
