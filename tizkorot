}

// שליחות שנכשלו (תגובת שרת שלא "OK", או ללא תגובה כלל) - לאבחון למה הודעה לא הגיעה בפועל.
// אין צורך בכפתור "נסה שוב" לתזכורות - הריצה הבאה (8:00/11:00) תנסה מחדש אוטומטית כל עוד
// השליחה לא הצליחה בפועל (ראו dailyReminderCheck). זו תצוגה לאבחון בלבד.
function getSendFailures() {
  try {
    const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("Send_Failures");
    if (!sheet) return [];
    const data = sheet.getDataRange().getValues();
    const rows = [];
    for (let i = 1; i < data.length; i++) {
      const d = data[i][0];
      let isoTime;
      try { isoTime = (d instanceof Date) ? d.toISOString() : new Date(d).toISOString(); } catch (e) { isoTime = new Date().toISOString(); }
      rows.push({ time: isoTime, phone: normalizePhone(data[i][1]), context: data[i][2], response: data[i][3] });
    }
    return rows.reverse(); // החדשות ראשונות
  } catch (e) { throw new Error(e.message); }
}

// גידול ברישום לפי חלון זמן (מצטבר - "שבוע אחרון" כולל גם את "יום אחרון" וכו').
// מבוסס על עמודת "תאריך רישום" ב-users, שמתעדכנת גם בעדכון רישום קיים (לא רק ברישום ראשון) -
// כלומר "אנשים" כאן זה "מי שנרשם או עדכן את הרישום בטווח הזה", לא בהכרח רישום חדש לגמרי.
// "פרקים" הוא סך כל הפרקים שכרגע רשומים אצל אותם משתמשים (אין תיעוד היסטורי per-פרק).
const REGISTRATION_GROWTH_WINDOWS = [
  { label: "שעה אחרונה", ms: 60 * 60 * 1000 },
  { label: "יום אחרון", ms: 24 * 60 * 60 * 1000 },
  { label: "שבוע אחרון", ms: 7 * 24 * 60 * 60 * 1000 },
  { label: "חודש אחרון", ms: 30 * 24 * 60 * 60 * 1000 },
  { label: "3 חודשים אחרונים", ms: 90 * 24 * 60 * 60 * 1000 },
  { label: "שנה אחרונה", ms: 365 * 24 * 60 * 60 * 1000 }
];

function getRegistrationGrowthStats() {
  try {
    const result = REGISTRATION_GROWTH_WINDOWS.map(w => ({ label: w.label, users: 0, chapters: 0 }));
    const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("users");
    if (!sheet) return result;

    const now = Date.now();
    const data = sheet.getDataRange().getValues();
    for (let i = 1; i < data.length; i++) {
      if (!normalizePhone(data[i][0])) continue;

      const regRaw = data[i][3];
      let regTime;
      try { regTime = (regRaw instanceof Date) ? regRaw.getTime() : new Date(regRaw).getTime(); } catch (e) { continue; }
      if (!regTime || isNaN(regTime)) continue;

      let chapterCount = 0;
      try {
        const arr = JSON.parse(data[i][2]);
        if (Array.isArray(arr)) chapterCount = arr.length;
      } catch (e) { /* JSON לא תקין בתא - סופרים את המשתמש בלי פרקים */ }

      const age = now - regTime;
      REGISTRATION_GROWTH_WINDOWS.forEach((w, idx) => {
        if (age <= w.ms) {
          result[idx].users += 1;
          result[idx].chapters += chapterCount;
        }
      });
    }
    return result;
  } catch (e) { throw new Error(e.message); }
}
